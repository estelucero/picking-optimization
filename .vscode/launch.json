      "module": "core.experiments.caso_2_muchos_pedidos",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Attach Backend Docker",
      "type": "python",
